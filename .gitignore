# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build
/dist

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

# Generated by `npm run build:data` from the sources in data/.
# Regenerate rather than commit: boundaries.geojson alone is ~1.8 MB.
/public/data
/public/photos

# Scratch downloads (ParseHub, studio-win32, browser installers) landed in data/
# during earlier scraping experiments. Nothing here is an input to build:data.
data/*.exe
data/scoped_dir*/

# Reference maps kept locally for comparison while building. 65 MB of SVG that
# no code reads and that git would refuse nothing useful about: kept on disk,
# out of the repository. If you want them versioned, use Git LFS instead.
data/reference/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
